# DEV ONLY. SQLite is not supported for production multi-process concurrency.
SHIPGATE_ENVIRONMENT=development
SHIPGATE_DATABASE_URL=sqlite:///./shipgate.db
SHIPGATE_TRUSTED_HOSTS=["localhost","127.0.0.1","testserver"]
SHIPGATE_MAX_REQUEST_BYTES=32768

# PRODUCTION EXAMPLE (not runnable without PostgreSQL, TLS proxy and your values):
# SHIPGATE_ENVIRONMENT=production
# SHIPGATE_DATABASE_URL=postgresql+psycopg://shipgate:REPLACE@postgres:5432/shipgate
# SHIPGATE_TRUSTED_HOSTS=["shipgate.example.com"]
